# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Port the server listens on (set automatically by Render / Railway / Heroku)
PORT=3000

# ─── Optional: Telegram Alerts ───────────────────────────────────────────────

# Create a bot at https://t.me/BotFather and copy the token here
TELEGRAM_BOT_TOKEN=

# Chat ID(s) to receive alerts — comma-separated for multiple recipients
# Get yours by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# Display name shown in Telegram messages (defaults to "Store")
STORE_NAME=My Toy Shop

# ─── Optional: Image Uploads ─────────────────────────────────────────────────

# Cloudinary URL — from your Cloudinary dashboard > Settings > API Keys
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# ─── Development only ────────────────────────────────────────────────────────

# Port the Vite dev server proxies /api calls to (default: 8080)
API_PORT=8080
