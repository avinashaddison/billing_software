# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Port the server listens on (set automatically by Render / Railway / Heroku)
PORT=3000

# ─── License ─────────────────────────────────────────────────────────────────

# License key issued by AddisonX. Leave empty to run in 14-day trial mode.
# Format: <base64payload>.<hmac>
LICENSE_KEY=

# ─── Optional: Telegram Alerts ───────────────────────────────────────────────

# Create a bot at https://t.me/BotFather and copy the token here
TELEGRAM_BOT_TOKEN=

# Chat ID(s) to receive alerts — comma-separated for multiple recipients
# Get yours by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# Display name in Telegram messages (overridden by store_settings if set)
STORE_NAME=

# ─── Optional: Image Uploads ─────────────────────────────────────────────────

# Cloudinary URL — from your Cloudinary dashboard > Settings > API Keys
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# Folder inside Cloudinary where product images are stored (default: counter/products)
CLOUDINARY_FOLDER=

# ─── Development only ────────────────────────────────────────────────────────

# Port the Vite dev server proxies /api calls to (default: 8080)
API_PORT=8080
